# Локальный docker compose уже задаёт эти значения сам.
# Для Render / Neon подставьте свои.

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/kompot?sslmode=require
SPRING_DATASOURCE_USERNAME=kompot
SPRING_DATASOURCE_PASSWORD=change-me
JWT_SECRET=replace-with-random-string-at-least-32-chars
APP_CORS_ORIGINS=https://your-frontend.onrender.com
API_URL=https://your-api.onrender.com/api
